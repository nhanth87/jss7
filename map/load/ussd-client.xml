<project basedir="." default="client" name="USSD Load Test Client"
         xmlns:if="ant:if" xmlns:unless="ant:unless">

    <!-- ============================================================= -->
    <!-- CONFIGURATION — override in client.properties                 -->
    <!-- ============================================================= -->
    <property file="client.properties"/>

    <!-- JSON config file for Ss7StackBuilder -->
    <property name="test.client.config" value="ss7-ussd-client.json"/>

    <!-- Load test params (passed as JVM system properties) -->
    <property name="test.client.numOfDialogs"       value="300000"/>
    <property name="test.client.concurrentDialog"   value="4000"/>
    <property name="test.client.rampUpPeriod"       value="0"/>

    <!-- ASN.1 telemetry — OFF for throughput runs (costs ~42% decode). Turn on only to inspect codec/heap. -->
    <property name="test.client.asnTelemetry" value="true"/>

    <!-- Monitoring for this round. Set false (or -Dtest.client.monitor=false) to disable next round.
         Produces: gc-client.log (ZGC pauses + allocation rate) and client.jfr (per-class heap
         object allocation, dumped on JVM exit — open with `jfr print` or JMC). -->
    <property name="test.client.monitor" value="true"/>

    <!-- JVM settings — 4g heap (16g box); ZGC headroom for high TPS -->
    <property name="jvm.xms"  value="4g"/>
    <property name="jvm.xmx"  value="4g"/>

    <!-- ============================================================= -->
    <!-- CLASSPATH                                                      -->
    <!-- ============================================================= -->

    <loadresource property="cp.list">
        <file file="ant-classpath.txt"/>
    </loadresource>

    <path id="full.class.path">
        <pathelement location="target/classes"/>
        <pathelement location="src/main/resources"/>
        <pathelement path="${cp.list}"/>
    </path>

    <!-- ============================================================= -->
    <!-- COMPILE via Maven                                              -->
    <!-- ============================================================= -->

    <target name="compile" description="Compile map-load module via Maven">
        <!-- NO -am: build only map/load against installed ~/.m2 jars. -am forces a full
             reactor rebuild with the Eclipse compiler (ECJ), which stubs *Impl classes
             (e.g. CBSDataCodingSchemeImpl) yet reports success → runtime "Unresolved
             compilation problem". Upstream jars in ~/.m2 are already good. -->
        <exec executable="mvn" dir="../.." failonerror="true">
            <arg line="compile -pl map/load -DskipTests -q"/>
        </exec>
        <echo message="Compile done. Refreshing classpath..."/>
        <exec executable="mvn" dir="." failonerror="true">
            <arg line="dependency:build-classpath -q -DincludeScope=runtime -Dmdep.outputFile=ant-classpath.txt"/>
        </exec>
    </target>

    <!-- ============================================================= -->
    <!-- CLIENT                                                         -->
    <!-- ============================================================= -->

    <target name="client" depends="compile" description="Run USSD Load Test Client">
        <echo message=""/>
        <echo message="============================================"/>
        <echo message="  MAP USSD Load Test CLIENT"/>
        <echo message="============================================"/>
        <echo message="Config         : ${test.client.config}"/>
        <echo message="Total dialogs  : ${test.client.numOfDialogs}"/>
        <echo message="Rate limit (TPS): ${test.client.concurrentDialog}"/>
        <echo message="Duration       : ~${test.client.numOfDialogs / test.client.concurrentDialog}s"/>
        <echo message="Ramp-up period : ${test.client.rampUpPeriod}s"/>
        <echo message="Heap           : ${jvm.xms}/${jvm.xmx}"/>
        <echo message="ASN telemetry  : ${test.client.asnTelemetry}"/>
        <echo message="============================================"/>
        <echo message=""/>

        <!-- Auto-delete stale XStream configs before start -->
        <delete quiet="true">
            <fileset dir="." includes="map-load-client-sccp_*.xml,map-load-client-tcap_*.xml,map-load-client-m3ua_*.xml,map-load-client-sctp_*.xml"/>
        </delete>
        <java classname="org.restcomm.protocols.ss7.map.load.ussd.Client"
              fork="true"
              jvm="/home/meodien/.local/share/mise/installs/java/zulu-25.34.17.0/bin/java"
              maxmemory="${jvm.xmx}"
              classpathref="full.class.path"
              failonerror="true">

            <jvmarg value="-Xms${jvm.xms}"/>
            <jvmarg value="-Xmx${jvm.xmx}"/>
            <!-- Generational ZGC (default on Java 25): low-pause, keeps p99 flat at high TPS -->
            <jvmarg value="-XX:+UseZGC"/>

            <!-- ── Monitoring (gated by test.client.monitor) ── -->
            <jvmarg if:true="${test.client.monitor}" value="-Xlog:gc*,gc+heap=info,safepoint:file=gc-client.log:tags,uptime,level"/>
            <jvmarg if:true="${test.client.monitor}" value="-XX:StartFlightRecording=settings=profile,filename=client.jfr,dumponexit=true"/>
            <jvmarg if:true="${test.client.monitor}" value="-XX:+UnlockDiagnosticVMOptions"/>
            <jvmarg if:true="${test.client.monitor}" value="-XX:NativeMemoryTracking=summary"/>

            <jvmarg value="-Dlog4j.defaultInitOverride=true"/>
            <jvmarg value="-Dlog4j.configurationFile=log4j2-client.xml"/>
            <jvmarg value="-Djava.net.preferIPv4Stack=true"/>
            <jvmarg value="-Dio.netty.leakDetection.level=disabled"/>
            <jvmarg value="-Dasn.telemetry.enabled=${test.client.asnTelemetry}"/>

            <!-- Load test params via system properties -->
            <jvmarg value="-Dss7.load.ndialogs=${test.client.numOfDialogs}"/>
            <jvmarg value="-Dss7.load.rateLimit=${test.client.concurrentDialog}"/>
            <jvmarg value="-Dss7.load.rampUp=${test.client.rampUpPeriod}"/>

            <!-- Single arg: JSON config file path -->
            <arg value="${test.client.config}"/>
        </java>
    </target>

    <!-- ============================================================= -->
    <!-- CLEAN                                                          -->
    <!-- ============================================================= -->

    <target name="clean" description="Clean logs + kill any running client">
        <exec executable="pkill" failonerror="false">
            <arg line="-f 'ussd.Client'"/>
        </exec>
        <delete file="client.log" failonerror="false"/>
        <echo message="Cleaned."/>
    </target>

</project>
