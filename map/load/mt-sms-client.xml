<project basedir="." default="client" name="MT-SMS Load Test Client"
         xmlns:if="ant:if" xmlns:unless="ant:unless">

    <!-- ============================================================= -->
    <!-- CONFIGURATION                                                 -->
    <!-- ============================================================= -->
    <property file="client.properties"/>

    <!-- JSON config file for Ss7StackBuilder -->
    <property name="test.client.config" value="ss7-mt-sms-client.json"/>

    <!-- Load test params (passed as JVM system properties) -->
    <property name="test.client.numOfDialogs"     value="60000"/>
    <property name="test.client.concurrentDialog" value="400"/>
    <property name="test.client.rampUpPeriod"     value="0"/>

    <!-- ASN.1 telemetry -->
    <property name="test.client.asnTelemetry" value="false"/>

    <!-- JVM settings — 1g heap, ZGC Generational -->
    <property name="jvm.xms" value="512m"/>
    <property name="jvm.xmx" value="1g"/>

    <!-- ============================================================= -->
    <!-- CLASSPATH                                                     -->
    <!-- ============================================================= -->
    <loadresource property="cp.list">
        <file file="ant-classpath.txt"/>
    </loadresource>

    <path id="full.class.path">
        <pathelement location="target/classes"/>
        <pathelement location="src/main/resources"/>
        <pathelement path="${cp.list}"/>
    </path>

    <!-- ============================================================= -->
    <!-- COMPILE via Maven                                             -->
    <!-- ============================================================= -->
    <target name="compile" description="Compile map-load module via Maven">
        <exec executable="mvn" dir="../.." failonerror="true">
            <arg line="compile -pl map/load -DskipTests -q -o"/>
        </exec>
        <echo message="Compile done. Refreshing classpath..."/>
        <exec executable="mvn" dir="../.." failonerror="true">
            <arg line="-pl map/load dependency:build-classpath -q -DincludeScope=runtime -Dmdep.outputFile=map/load/ant-classpath.txt -o"/>
        </exec>
    </target>

    <!-- ============================================================= -->
    <!-- CLIENT                                                        -->
    <!-- ============================================================= -->
    <target name="client" depends="compile" description="Start MT-SMS Load Test Client">
        <echo message=""/>
        <echo message="============================================"/>
        <echo message="  MAP MT-SMS Load Test CLIENT"/>
        <echo message="============================================"/>
        <echo message="Config      : ${test.client.config}"/>
        <echo message="Heap        : ${jvm.xms}/${jvm.xmx}"/>
        <echo message="NDIALOGS    : ${test.client.numOfDialogs}"/>
        <echo message="Rate Limit  : ${test.client.concurrentDialog}"/>
        <echo message="Ramp-up     : ${test.client.rampUpPeriod}"/>
        <echo message="============================================"/>
        <echo message=""/>

        <!-- Auto-delete stale XStream configs before start -->
        <delete quiet="true">
            <fileset dir="." includes="map-load-mt-sms-client-*.xml"/>
        </delete>

        <java classname="org.restcomm.protocols.ss7.map.load.sms.mt.Client"
              fork="true"
              jvm="/home/meodien/.local/share/mise/installs/java/zulu-25.34.17.0/bin/java"
              maxmemory="${jvm.xmx}"
              classpathref="full.class.path"
              failonerror="true">

            <jvmarg value="-Xms${jvm.xms}"/>
            <jvmarg value="-Xmx${jvm.xmx}"/>
            <jvmarg value="-XX:+UseZGC"/>
            <jvmarg value="-XX:ConcGCThreads=2"/>
            <jvmarg value="-Dlog4j.defaultInitOverride=true"/>
            <jvmarg value="-Dlog4j.configurationFile=log4j2-client.xml"/>
            <jvmarg value="-Djava.net.preferIPv4Stack=true"/>
            <jvmarg value="-Dio.netty.leakDetection.level=disabled"/>
            <jvmarg value="-Dasn.telemetry.enabled=${test.client.asnTelemetry}"/>

            <!-- Load test parameters via system properties -->
            <sysproperty key="ss7.load.ndialogs"          value="${test.client.numOfDialogs}"/>
            <sysproperty key="ss7.load.rateLimit"         value="${test.client.concurrentDialog}"/>
            <sysproperty key="ss7.load.rampUp"            value="${test.client.rampUpPeriod}"/>
            <sysproperty key="ss7.load.senderThreads"     value="8"/>

            <arg value="${test.client.config}"/>
        </java>
    </target>

    <!-- ============================================================= -->
    <!-- CLEAN                                                         -->
    <!-- ============================================================= -->
    <target name="clean" description="Kill client + clean logs">
        <exec executable="pkill" failonerror="false">
            <arg line="-f 'sms.mt.Client'"/>
        </exec>
        <delete file="client.log" failonerror="false"/>
        <delete quiet="true">
            <fileset dir="." includes="map-load-mt-sms-client-*.xml"/>
        </delete>
        <delete file="mt-sms.csv" failonerror="false"/>
        <echo message="Cleaned."/>
    </target>

</project>
