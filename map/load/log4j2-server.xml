<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <!-- File only during load — Console appender fights the TUI and causes scroll jump. -->
    <File name="ServerFile" fileName="server.log" append="false">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </File>
  </Appenders>
  <Loggers>
    <Root level="WARN">
      <AppenderRef ref="ServerFile"/>
    </Root>
    <Logger name="org.restcomm" level="WARN"/>
    <Logger name="org.mobicents" level="WARN"/>
    <Logger name="map.test" level="INFO"/>
  </Loggers>
</Configuration>
