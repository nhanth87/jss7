<project basedir="." default="server" name="USSD Load Test Server"
         xmlns:if="ant:if" xmlns:unless="ant:unless">

    <!-- ============================================================= -->
    <!-- CONFIGURATION — override in server.properties                 -->
    <!-- ============================================================= -->
    <property file="server.properties"/>

    <!-- JSON config file for Ss7StackBuilder -->
    <property name="test.server.config" value="ss7-ussd-server.json"/>

    <!-- ASN.1 telemetry — set to true to show BerCursor stats in TUI (+3ns/op) -->
    <property name="test.server.asnTelemetry" value="false"/>

    <!-- JVM settings — 8g heap for gateway headroom under 4k TPS (avoid MEMORY congestion @77%) -->
    <property name="jvm.xms" value="8g"/>
    <property name="jvm.xmx" value="8g"/>

    <!-- ============================================================= -->
    <!-- CLASSPATH  (from Maven ant-classpath.txt)                      -->
    <!-- ============================================================= -->

    <loadresource property="cp.list">
        <file file="ant-classpath.txt"/>
    </loadresource>

    <path id="full.class.path">
        <pathelement location="target/classes"/>
        <pathelement location="src/main/resources"/>
        <pathelement path="${cp.list}"/>
    </path>

    <!-- ============================================================= -->
    <!-- COMPILE via Maven                                              -->
    <!-- ============================================================= -->

    <target name="compile" description="Compile map-load module via Maven">
        <exec executable="mvn" dir="../.." failonerror="true">
            <arg line="compile -pl map/load -DskipTests -q -o"/>
        </exec>
        <echo message="Compile done. Refreshing classpath..."/>
        <exec executable="mvn" dir="../.." failonerror="true">
            <arg line="-pl map/load dependency:build-classpath -q -DincludeScope=runtime -Dmdep.outputFile=map/load/ant-classpath.txt -o"/>
        </exec>
    </target>

    <!-- ============================================================= -->
    <!-- SERVER                                                         -->
    <!-- ============================================================= -->

    <target name="server" depends="compile" description="Start USSD Load Test Server">
        <echo message=""/>
        <echo message="============================================"/>
        <echo message="  MAP USSD Load Test SERVER"/>
        <echo message="============================================"/>
        <echo message="Config      : ${test.server.config}"/>
        <echo message="Heap        : ${jvm.xms}/${jvm.xmx}"/>
        <echo message="ASN telemetry: ${test.server.asnTelemetry}"/>
        <echo message="============================================"/>
        <echo message=""/>

        <!-- Auto-delete stale XStream configs before start -->
        <delete quiet="true">
            <fileset dir="." includes="map-load-server-sccp_*.xml,map-load-server-tcap_*.xml,map-load-server-m3ua_*.xml,map-load-server-sctp_*.xml"/>
        </delete>
        <java classname="org.restcomm.protocols.ss7.map.load.ussd.Server"
              fork="true"
              jvm="/home/meodien/.local/share/mise/installs/java/zulu-25.34.17.0/bin/java"
              maxmemory="${jvm.xmx}"
              classpathref="full.class.path"
              failonerror="true">

            <jvmarg value="-Xms${jvm.xms}"/>
            <jvmarg value="-Xmx${jvm.xmx}"/>
            <!-- Generational ZGC: low-pause, keeps p99 flat at high TPS -->
            <jvmarg value="-XX:+UseZGC"/>
            <jvmarg value="-XX:ConcGCThreads=4"/>
            <jvmarg value="-XX:ParallelGCThreads=8"/>
            <jvmarg value="-Dlog4j.defaultInitOverride=true"/>
            <jvmarg value="-Dlog4j.configurationFile=log4j2-server.xml"/>
            <jvmarg value="-Djava.net.preferIPv4Stack=true"/>
            <jvmarg value="-Dio.netty.leakDetection.level=disabled"/>
            <jvmarg value="-Dasn.telemetry.enabled=${test.server.asnTelemetry}"/>
            <!-- TCAP: more timer/callback threads; hybrid wheel invoke + sticky idle -->
            <jvmarg value="-Dss7.tcap.executorThreads=16"/>
            <!-- Raise memory congestion L1 from default 77% — ZGC often sits high; avoid outgoing throttle -->
            <jvmarg value="-Dss7.tcap.memoryCongestionL1=90"/>
            <jvmarg value="-Dss7.tcap.memoryCongestionL2=95"/>
            <jvmarg value="-Dss7.tcap.memoryCongestionL3=98"/>

            <!-- Single arg: JSON config file path -->
            <arg value="${test.server.config}"/>
        </java>
    </target>

    <!-- ============================================================= -->
    <!-- CLEAN                                                          -->
    <!-- ============================================================= -->

    <target name="clean" description="Clean logs + kill any running server">
        <exec executable="pkill" failonerror="false">
            <arg line="-f 'ussd.Server'"/>
        </exec>
        <delete file="server.log" failonerror="false"/>
        <echo message="Cleaned."/>
    </target>

</project>
