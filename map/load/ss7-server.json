{
  "stackName": "map-load-server",
  "protocols": { "map": true, "cap": false },
  "sctp": {
    "connectDelay": 10000,
    "workerThreads": 8,
    "links": [
      { "name": "serverLink", "type": "server", "local": "127.0.0.1:8011", "peer": "127.0.0.1:8012" }
    ]
  },
  "m3ua": {
    "deliveryThreads": 16,
    "as": [
      { "name": "AS1", "mode": "loadshare", "functionality": "ipsp", "ipsp": "server",
        "routingContext": 101, "networkAppearance": 102, "links": ["serverLink"] }
    ],
    "routes": [
      { "to": { "dpc": 1, "opc": 2, "si": 3 }, "via": "AS1" }
    ]
  },
  "sccp": {
    "localPoints": [
      { "pc": 2, "networkIndicator": "national", "networkId": 0, "reachablePointCodes": [1] }
    ],
    "routing": [
      { "from": "remote", "match": { "gt": "*/" }, "to": { "pc": 2 } },
      { "from": "local",  "match": { "gt": "*/" }, "to": { "pc": 1 } }
    ]
  },
  "tcap": {
    "dialogIdleTimeout": 15000,
    "invokeTimeout": 10000,
    "maxDialogs": 25000
  },
  "services": [
    { "name": "msc",  "ssn": 8,   "protocol": "map" },
    { "name": "ussd", "ssn": 147, "protocol": "map" }
  ]
}

